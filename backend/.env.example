# Copy this file to ".env" for local development. On Render, add the same keys under
# Environment Variables instead (never commit a real .env). PORT is set by Render automatically.

# --- AI provider: any OpenAI-compatible API. Pick ONE block. ---

# Google Gemini (free tier) - key from https://aistudio.google.com/apikey
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-lite-latest
OPENAI_FALLBACK_MODEL=gemini-flash-latest

# Groq (free tier) - key from https://console.groq.com/keys
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# OpenAI (paid) - leave OPENAI_BASE_URL unset
# OPENAI_MODEL=gpt-4o-mini

# --- Keep student data when the server restarts (REQUIRED on Render's free plan) ---
# A free Postgres database from https://neon.tech (or Supabase). Paste its connection string here.
# Without it, students/chats/scores are saved in files and are erased on every redeploy.
DATABASE_URL=
# Optional: another folder for saved data (e.g. a Render Persistent Disk mounted at /var/data)
# DATA_DIR=

# --- Enquiry form: email each enquiry to you (optional; enquiries are always saved in the Admin tab) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
#        SMTP_PASS=a 16-character "App password" (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ENQUIRY_TO=
# ENQUIRY_FROM=Speakeasy Academy <you@example.com>

# --- Admin tab password (use a long one on a public site) ---
ADMIN_PASSWORD=change-me

# --- Local only (default 5000) ---
PORT=5000
