# --- AI provider (any OpenAI-compatible API). Pick ONE block. ---

# Google Gemini (free tier) - key from https://aistudio.google.com/apikey
OPENAI_API_KEY=your-google-ai-studio-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-2.0-flash
OPENAI_FALLBACK_MODEL=gemini-1.5-flash

# Groq (free tier) - key from https://console.groq.com/keys
# OPENAI_API_KEY=your-groq-key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# OpenAI (paid) - leave OPENAI_BASE_URL unset
# OPENAI_MODEL=gpt-4o-mini

ADMIN_PASSWORD=
PORT=3000
